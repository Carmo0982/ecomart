# ─────────────────────────────────────────────────────────────────────
# EcoMart · Variables de entorno del CLIENTE (Vite)
# Copia este archivo como .env.local y completa los valores.
#
# ⚠ Todo lo que empieza por VITE_ se incrusta en el JavaScript público que
#   descarga el navegador. Aquí solo van valores que PUEDEN ser públicos.
#
# ⛔ NUNCA agregues aquí la service_role key (ni con prefijo VITE_ ni sin él).
#   Esa clave salta todas las políticas RLS. Solo debe vivir en el servidor
#   (Edge Functions, backend, CI) como secreto. Si alguna vez se publicó,
#   rótala en Supabase → Project Settings → API.
#
# Sin estas variables la app arranca en "modo demostración" con un catálogo
# local.
# ─────────────────────────────────────────────────────────────────────

# URL del proyecto: Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Clave pública "anon" (o la "publishable key" sb_publishable_…).
# Es segura en el navegador porque RLS protege los datos.
VITE_SUPABASE_ANON_KEY=<tu-anon-key>
